#include <winver.h>

1 VERSIONINFO
 FILEVERSION 2,6,4,0
 PRODUCTVERSION 2,6,4,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Antigravity-Proxy Contributors"
            VALUE "FileDescription", "Antigravity-Proxy System Proxy Edition (version.dll shim)"
            VALUE "FileVersion", "2.6.4.0"
            VALUE "InternalName", "version.dll"
            VALUE "LegalCopyright", "BSD-2-Clause License"
            VALUE "OriginalFilename", "version.dll"
            VALUE "ProductName", "Antigravity-Proxy"
            VALUE "ProductVersion", "2.6.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
